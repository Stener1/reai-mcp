{
  "name": "reai-mcp",
  "version": "0.3.0",
  "description": "MCP server for ReAI (app.reai.no) \u2014 Norwegian accounting. Curated bookkeeping tools plus full-API escape hatch. Runs as local stdio or self-hosted remote connector.",
  "license": "MIT",
  "author": "Stener Torstensen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stener1/reai-mcp.git"
  },
  "homepage": "https://github.com/Stener1/reai-mcp#readme",
  "bugs": {
    "url": "https://github.com/Stener1/reai-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "reai",
    "accounting",
    "regnskap",
    "norway",
    "bookkeeping",
    "claude"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "reai-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "spec/index.json",
    "spec/reai-openapi.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:spec": "node scripts/build-spec-index.mjs",
    "build": "npm run build:spec && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "audit:messages": "node scripts/audit-messages.mjs",
    "audit:storage": "node scripts/audit-storage.mjs",
    "audit:quirks": "node scripts/audit-quirks.mjs",
    "audit:census": "node scripts/storage-census.mjs",
    "check:deployed": "node scripts/check-deployed.mjs",
    "sweep:discovery": "npm run build && node scripts/discovery-sweep.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "hono": "4.12.34"
  }
}
