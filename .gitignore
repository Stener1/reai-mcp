node_modules/
# Without the slash too. A trailing slash matches a DIRECTORY only, so a symlink named
# node_modules slipped past it and got committed from a git worktree — an absolute path into
# one developer's home directory, in a public repo. It survived CI because npm install
# replaced it, which is exactly why nothing noticed.
node_modules
dist/
*.log
.env
.env.*
!.env.example
.DS_Store
spec/index.json

# Agent scratch space. `.claude/worktrees/` holds real git worktrees, and `git add -A`
# stages one as a gitlink — a 160000 entry pointing at a commit nobody can fetch, which
# is how a submodule that does not exist gets committed to a public repo.
.claude/worktrees/
coverage/
*.tsbuildinfo
