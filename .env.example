# --- Required ---------------------------------------------------------------
# ReAI user API token. Create one in app.reai.no under settings -> API tokens.
# A user token can reach every tenant (company) your ReAI user has access to;
# discover them with the reai_whoami tool.
# REAI_TOKEN is accepted as an alias, for compatibility with existing scripts.
REAI_USER_API_TOKEN=

# --- Recommended -----------------------------------------------------------
# Default tenant (company) id, so you don't have to pass tenantId on every call.
# Find yours with reai_whoami. If your token reaches exactly one tenant you can
# leave this unset and call reai_use_tenant once per session instead.
REAI_TENANT_ID=

# How much this server is allowed to change. Default: reversible.
#   read-only   GET requests only. Nothing can be modified.
#   reversible  Also master data that can be cleanly deleted again -- customers,
#               suppliers, products, departments, offers.
#   full        Everything, including general-ledger postings, invoices,
#               payments, payroll and VAT returns. These CANNOT be cleanly
#               undone; under Norwegian bookkeeping law a voucher in a closed
#               period must be corrected with a reversing entry, not deleted.
REAI_WRITE_MODE=reversible

# May this server send anything to a THIRD PARTY? EHF/Peppol invoices, invoice
# emails, payment reminders, signing requests -- and issuing a customer invoice,
# which starts delivery asynchronously.
#
# Off by default, and deliberately SEPARATE from REAI_WRITE_MODE. A write mode
# governs what can be undone in the books; this governs whether anything reaches
# someone else, which cannot be undone at all. Even REAI_WRITE_MODE=full sends
# nothing without this.
#
# Turn it ON for a real business doing its own invoicing -- that is the normal
# case and the whole point of an accounting system. Leave it OFF while evaluating,
# or when testing against a tenant whose real counterparties should not hear from
# you.
# REAI_ALLOW_EXTERNAL_SEND=1

# --- Optional --------------------------------------------------------------
# Override the API base URL (for a staging environment).
# REAI_BASE_URL=https://app.reai.no

# Per-request timeout in milliseconds (default 30000).
# REAI_TIMEOUT_MS=30000

# Retries for transient failures: 429, 502, 503, 504 (default 2).
#
# A 5xx or a timeout is ambiguous -- the write may already have been committed --
# so those are only retried for GET, HEAD and DELETE. Booking a voucher is never
# repeated, since it has no idempotency key and a duplicate posting cannot be
# removed once the period closes. 429 is retried for every method, because it is
# rejected before being processed. Set to 0 to disable retries entirely.
# REAI_MAX_RETRIES=2

# Log one line per API request to stderr. Never logs tokens.
# REAI_VERBOSE=1

# Which curated tool groups to expose, comma-separated. Empty (the default)
# enables all of them. Valid groups: bookkeeping, sales, purchase, bank, organisation, assets,
# subscriptions, warehouses, agreements, salary, reference, loans.
# Narrowing keeps the tool list short for clients with a limited budget; the
# discovery tools are never disabled, so every endpoint stays reachable through
# reai_search_endpoints + reai_request.
#   bookkeeping       -> 19 tools
#   bookkeeping,sales -> 49 tools
#   organisation      -> 25 tools
#   assets            -> 13 tools
#   subscriptions     -> 16 tools
#   warehouses        -> 14 tools
#   agreements        -> 12 tools
#   salary            -> 14 tools
#   loans             -> 20 tools
#   (unset)           -> all 156
# REAI_TOOLSETS=bookkeeping,sales

# --- Remote / connector mode only ------------------------------------------
# Port for the HTTP transport (default 8080).
# PORT=8080

# Public base URL of this deployment. Set this in production: it is published in
# the OAuth metadata documents, so it must match the URL clients connect to.
# Inferred from the Host / X-Forwarded-* headers when unset.
# REAI_PUBLIC_URL is accepted as an alias.
# PUBLIC_URL=https://reai-mcp.example.com

# Seals access tokens (AES-256-GCM), which is how a user's ReAI token is carried
# without any server-side session store. REQUIRED in production -- without it a
# random key is generated at startup, so every existing connector authorization
# breaks on restart and separate instances reject each other's tokens.
# 32 bytes, base64 or hex. Treat it like a credential: it decrypts every user's
# ReAI token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REAI_ENCRYPTION_KEY=

# Comma-separated hostnames this server will answer to. Setting it enables
# DNS-rebinding protection on the MCP endpoint, and stops a client-supplied Host
# header from deciding what this deployment advertises as its OAuth issuer.
# REAI_ALLOWED_HOSTS=reai-mcp.example.com

# Comma-separated hosts allowed as OAuth redirect targets. Strongly recommended
# on a public deployment. Client registration is open (that is what MCP clients
# expect), so without this anyone can register a client pointing at their own
# callback and drive a genuine-looking consent page on YOUR domain to collect
# someone's ReAI token. Loopback is always permitted, for local clients.
# REAI_ALLOWED_REDIRECT_HOSTS=claude.ai

# Accept a raw ReAI token in the Authorization header instead of requiring the
# OAuth flow. Convenient for a private deployment behind Tailscale or IAP.
# DANGEROUS on a public URL: anyone who can reach it acts as whoever's token
# they present.
# REAI_ALLOW_TOKEN_PASSTHROUGH=1

# Expose the bank-reconciliation pairing view as an MCP UI resource (HTML). Off by
# default: a host that does not support MCP Apps cannot launch the view, and would still
# be handed a tool whose point it cannot honour plus a structuredContent payload it puts
# in front of the model. It adds no capability — the view selects, it does not write, and
# matching still goes through the write policy.
# REAI_ENABLE_UI=1
